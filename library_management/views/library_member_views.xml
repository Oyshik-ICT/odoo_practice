<odoo>
    <record id="library_member_form_view" model="ir.ui.view">
        <field name="name">library.member.view.form</field>
        <field name="model">library.member</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="phone"/>
                        <field name="email"/>
                        <field name="join_date"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="library_member_list_view" model="ir.ui.view">
        <field name="name">library.member.view.list</field>
        <field name="model">library.member</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="join_date"/>
            </list>
        </field>
    </record>

    <record id="library_member_action" model="ir.actions.act_window">
        <field name="name">Library Member action</field>
        <field name="res_model">library.member</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>