<odoo>
    <template id="report_book">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 t-field="doc.name"/>
                        <p>Author: <span t-field="doc.author"/></p>
                        <p>ISBN: <span t-field="doc.isbn"/></p>
                        <p>State: <span t-field="doc.state"/></p>
                        <p>Total Copies: <span t-field="doc.total_copies"/></p>
                        <p>Available Copies: <span t-field="doc.available_copies"/></p>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>