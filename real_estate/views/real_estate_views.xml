<odoo>

    <record id="real_estate_search_view" model="ir.ui.view">
        <field name="name">real.estate.view.search</field>
        <field name="model">real.estate</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter string="New" name="new_state" domain='[("state", "=", "new")]'/>
                <filter string="Sold" name="sold_state" domain='[("state", "=", "sold")]'/>
                <filter string="Post Code Group" name="groub_by_post_code" context="{'group_by': 'post_code'}"/>
                <filter string="State  Group" name="groub_by_state" context="{'group_by': 'state'}"/>

            </search>
        </field>
    </record>

    <record id="real_estate_form_view" model="ir.ui.view">
        <field name="name">real.estate.view.form</field>
        <field name="model">real.estate</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <header>
                        <button string="Sold" type="object" name="sold_button"/>
                        <button string="Cancel" type="object" name="cancel_button"/>
                        <field name="state" widget="statusbar"
                            statusbar_visible="new,received,accepted,sold"/>
                    </header>
                    <group>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </group>
                    <group>
                        <group>
                            <field name="post_code"/>
                            <field name="date_availability"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="price"/>
                            <field name="selling_price"/>
                            <field name="property_type_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <group>
                                <field name="description"/>
                                <field name="bed_rooms"/>
                                <field name="garage"/>
                                <field name="garden_orientation"/>
                                <field name="living_areas"/>
                                <field name="garden" widget="boolean_toggle"/>
                                <field name="garden_areas"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>

            </form>
        </field>
    </record>

    <record id="real_estate_list_view" model="ir.ui.view">
        <field name="name">real.estate.view.list</field>
        <field name="model">real.estate</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="description"/>
                <field name="state"/>
                <field name="active"/>
                <field name="post_code"/>
                <field name="property_type_id"/>
                <field name="total_areas"/>
                <!-- list view -->
                <field name="currency_id" invisible="1"/>
                <field name="price" widget="monetary" options="{'currency_field': 'currency_id'}"/>
            </list>
        </field>
    </record>


    <record id="test_record" model="ir.actions.act_window">
        <field name="name">Test</field>
        <field name="res_model">real.estate</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>